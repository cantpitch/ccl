{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch darmcl64",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/darmcl64",
            "args": ["-I", "fake-darmcl64.image"], // use x86-64 image for dev
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Darwin ARM64 Kernel",
            "preRunCommands": [
                "process handle -p true -s false -n false SIGKILL SIGILL SIGSEGV SIGBUS SIGFPE SIGUSR1 SIGUSR2 SIGEMT",
                "command alias arg_x expr print_lisp_object($x13)",
                "command alias arg_y expr print_lisp_object($x14)",
                "command alias arg_z expr print_lisp_object($x15)",
                "command alias fn expr print_lisp_object($x16)",
                "command alias lbt expr plbt_sp($sp)",
            ]
        },
        {
            "name": "Launch dx86cl64",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/dx86cl64",
            "args": ["-I", "dx86cl64.image"],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Launch x64 testrunner",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/lisp-kernel/darwinx8664/testrunner",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Launch lx86cl64",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/lx86cl64",
            "args": ["-I", "lx86cl64.image"],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Launch lx86cl32",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/lx86cl32",
            "args": ["-I", "lx86cl32.image"],
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Launch image-parser",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/lisp-kernel/image-parser/image-parser",
            "args": ["nothing"],
            "cwd": "${workspaceFolder}/lisp-kernel/image-parser",
        },
        {
            "name": "Launch wx86cl64",
            "type": "cppdbg",
            "MIMode": "gdb",
            "externalConsole": false,
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "request": "launch",
            "program": "${workspaceFolder}/wx86cl64.exe",
            "args": ["-I", "wx86cl64.image"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Windows x86-64 Lisp Kernel",
        },
    ]
}