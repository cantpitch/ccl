{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Windows x86-64 Lisp Kernel",
            "options": {
                "cwd": "${workspaceFolder}\\lisp-kernel\\win64",
                "env": {
                    "PATH": "${env:PATH};C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin"
                }
            },
            "command": "make",
            "args": [
                "-f",
                "Makefile",
                "all",
            ]
        },
        {
            "type": "shell",
            "label": "Build Darwin ARM64 Kernel",
            "options": {
                "cwd": "${workspaceFolder}/lisp-kernel/darwinarm64"
            },
            "command": "make",
            "args": [
                "-f",
                "Makefile",
                "all"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Build Darwin x86-64 Kernel",
            "options": {
                "cwd": "${workspaceFolder}/lisp-kernel/darwinx8664"
            },
            "command": "make",
            "args": [
                "-f",
                "Makefile",
                "all"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "shell",
            "label": "Build Linux x86-64 Kernel",
            "options": {
                "cwd": "${workspaceFolder}/lisp-kernel/linuxx8664"
            },
            "command": "make",
            "args": [
                "-f",
                "Makefile",
                "all"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
    ]
}